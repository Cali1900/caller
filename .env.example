# Caller — environment. Copy to .env and fill in.
#
# HARD RULE: docker-compose.yml uses ${VAR:?...} for every one of these.
# There are NO defaults in compose. A missing value stops the stack rather
# than silently resolving to something stale.

# ---- database (bound to 127.0.0.1 only) ----
CALLER_DB_NAME=caller_db
CALLER_DB_USER=calleruser
CALLER_DB_PASSWORD=change-me
CALLER_DB_PORT=4102

# ---- THE DIAL GUARD ----
# allowlist   = dev. Only numbers in DIAL_ALLOWLIST can be dialed.
# unrestricted = prod, and only prod.
#
# An EMPTY DIAL_ALLOWLIST dials nothing. That is correct, not a bug.
DIAL_MODE=allowlist
DIAL_ALLOWLIST=

CALLER_API_PORT=4100
